<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yankit Kukreja - Maritime Engineer & Systems Specialist</title>
    <meta name="description" content="Maritime Engineer and Systems Specialist with experience in space systems, naval operations, and GIS technologies.">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        :root {
            --bg: #ffffff;
            --text: #1a1a1a;
            --accent: #0066ff;
            --gray: #666666;
            --light-gray: #f5f5f5;
        }
        
        html {
            scroll-behavior: smooth;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            font-size: 18px;
            overflow-x: hidden;
        }
        
        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            padding: 2rem 4rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
        }
        
        nav .logo {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--text);
            text-decoration: none;
        }
        
        nav ul {
            list-style: none;
            display: flex;
            gap: 3rem;
        }
        
        nav a {
            color: var(--text);
            text-decoration: none;
            font-size: 0.95rem;
            transition: color 0.3s;
        }
        
        nav a:hover {
            color: var(--accent);
        }
        
        /* Hero Section */
        .hero {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4rem;
            text-align: center;
        }
        
        .hero-content h1 {
            font-size: 6rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.1;
            margin-bottom: 1.5rem;
        }
        
        .hero-content p {
            font-size: 1.5rem;
            color: var(--gray);
            max-width: 600px;
            margin: 0 auto;
            font-weight: 300;
        }
        
        .hero-content .cta {
            margin-top: 3rem;
            display: inline-block;
            padding: 1rem 2.5rem;
            background: var(--accent);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-size: 1rem;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        
        .hero-content .cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0, 102, 255, 0.3);
        }
        
        /* Section Base */
        section {
            padding: 8rem 4rem;
            max-width: 1400px;
            margin: 0 auto;
        }
        
        section h2 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 4rem;
            letter-spacing: -0.02em;
        }
        
        /* About */
        .about-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6rem;
            align-items: center;
        }
        
        .about-text p {
            font-size: 1.3rem;
            line-height: 1.8;
            color: var(--gray);
            margin-bottom: 2rem;
        }
        
        .about-text p:last-child {
            margin-bottom: 0;
        }
        
        .about-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }
        
        .stat {
            text-align: center;
        }
        
        .stat-number {
            font-size: 3rem;
            font-weight: 700;
            color: var(--accent);
            display: block;
        }
        
        .stat-label {
            color: var(--gray);
            font-size: 0.95rem;
            margin-top: 0.5rem;
        }
        
        /* Projects */
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 3rem;
        }
        
        .project-card {
            background: var(--light-gray);
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.3s;
            cursor: pointer;
        }
        
        .project-card:hover {
            transform: translateY(-8px);
        }
        
        .project-image {
            width: 100%;
            height: 300px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2rem;
            font-weight: 600;
        }
        
        .project-content {
            padding: 2rem;
        }
        
        .project-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        
        .project-description {
            color: var(--gray);
            line-height: 1.6;
            margin-bottom: 1rem;
        }
        
        .project-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        
        .tag {
            background: white;
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-size: 0.85rem;
            color: var(--gray);
        }
        
        /* Experience */
        .experience-list {
            max-width: 900px;
        }
        
        .experience-item {
            border-left: 2px solid var(--accent);
            padding-left: 2rem;
            margin-bottom: 3rem;
            position: relative;
        }
        
        .experience-item::before {
            content: '';
            position: absolute;
            left: -6px;
            top: 0;
            width: 10px;
            height: 10px;
            background: var(--accent);
            border-radius: 50%;
        }
        
        .experience-year {
            font-size: 0.9rem;
            color: var(--accent);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }
        
        .experience-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }
        
        .experience-company {
            color: var(--gray);
            margin-bottom: 1rem;
        }
        
        .experience-description {
            color: var(--gray);
            line-height: 1.8;
        }
        
        /* Contact */
        .contact-content {
            text-align: center;
            max-width: 600px;
            margin: 0 auto;
        }
        
        .contact-content p {
            font-size: 1.3rem;
            color: var(--gray);
            margin-bottom: 2rem;
        }
        
        .contact-email {
            font-size: 2rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 2rem;
        }
        
        .contact-email:hover {
            text-decoration: underline;
        }
        
        .social-links {
            display: flex;
            gap: 2rem;
            justify-content: center;
        }
        
        .social-links a {
            color: var(--gray);
            text-decoration: none;
            font-size: 1.1rem;
            transition: color 0.3s;
        }
        
        .social-links a:hover {
            color: var(--accent);
        }
        
        /* Footer */
        footer {
            padding: 3rem 4rem;
            text-align: center;
            color: var(--gray);
            border-top: 1px solid #eee;
        }
        
        /* Animations */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }
        
        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }
        
        .slide-left {
            opacity: 0;
            transform: translateX(-50px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }
        
        .slide-left.visible {
            opacity: 1;
            transform: translateX(0);
        }
        
        .slide-right {
            opacity: 0;
            transform: translateX(50px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }
        
        .slide-right.visible {
            opacity: 1;
            transform: translateX(0);
        }
        
        .scale-in {
            opacity: 0;
            transform: scale(0.9);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }
        
        .scale-in.visible {
            opacity: 1;
            transform: scale(1);
        }
        
        /* Staggered animations */
        .stagger-1 { transition-delay: 0.1s; }
        .stagger-2 { transition-delay: 0.2s; }
        .stagger-3 { transition-delay: 0.3s; }
        .stagger-4 { transition-delay: 0.4s; }
        .stagger-5 { transition-delay: 0.5s; }
        .stagger-6 { transition-delay: 0.6s; }
        
        /* Respect reduced motion preference */
        @media (prefers-reduced-motion: reduce) {
            .fade-in,
            .slide-left,
            .slide-right,
            .scale-in {
                opacity: 1;
                transform: none;
                transition: none;
            }
        }
        
        /* Responsive */
        @media (max-width: 968px) {
            nav {
                padding: 1.5rem 2rem;
            }
            
            nav ul {
                gap: 1.5rem;
            }
            
            .hero {
                padding: 0 2rem;
            }
            
            .hero-content h1 {
                font-size: 3.5rem;
            }
            
            .hero-content p {
                font-size: 1.2rem;
            }
            
            section {
                padding: 5rem 2rem;
            }
            
            section h2 {
                font-size: 2.5rem;
                margin-bottom: 3rem;
            }
            
            .about-content {
                grid-template-columns: 1fr;
                gap: 3rem;
            }
            
            .projects-grid {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 640px) {
            .hero-content h1 {
                font-size: 2.5rem;
            }
            
            nav ul {
                display: none;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav>
        <a href="#" class="logo">YK</a>
        <ul>
            <li><a href="#about">About</a></li>
            <li><a href="#work">Work</a></li>
            <li><a href="#experience">Experience</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>
    
    <!-- Hero -->
    <section class="hero">
        <div class="hero-content">
            <h1>Yankit Kukreja</h1>
            <p>Maritime Engineer & Systems Specialist exploring the intersection of space, ocean, and sustainable systems.</p>
            <a href="#work" class="cta">View My Work</a>
        </div>
    </section>
    
    <!-- About -->
    <section id="about">
        <h2 class="fade-in">About Me</h2>
        <div class="about-content">
            <div class="about-text slide-left">
                <p>I'm a maritime engineer and systems specialist with a unique blend of experience spanning naval operations, space systems engineering, and geospatial technologies.</p>
                <p>Currently pursuing my MSS at ISU in Strasbourg, France, I bring hands-on experience from 9 years at sea across 7 vessels and multiple space engineering projects including CubeSat development.</p>
            </div>
            <div class="about-stats slide-right">
                <div class="stat scale-in stagger-1" data-target="7">
                    <span class="stat-number">0</span>
                    <span class="stat-label">Vessels Sailed</span>
                </div>
                <div class="stat scale-in stagger-2" data-target="6">
                    <span class="stat-number">0</span>
                    <span class="stat-label">Major Projects</span>
                </div>
                <div class="stat scale-in stagger-3" data-target="15">
                    <span class="stat-number">0</span>
                    <span class="stat-label">Trade Routes</span>
                </div>
                <div class="stat scale-in stagger-4" data-target="24">
                    <span class="stat-number">0</span>
                    <span class="stat-label">Revenue Generated</span>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Projects -->
    <section id="work">
        <h2 class="fade-in">Selected Work</h2>
        <div class="projects-grid">
            <div class="project-card fade-in stagger-1">
                <div class="project-image">🛰️</div>
                <div class="project-content">
                    <h3 class="project-title">Atmos X CubeSat</h3>
                    <p class="project-description">Designed and built a CubeSat satellite for atmospheric research. Led systems engineering, integration, and testing protocols.</p>
                    <div class="project-tags">
                        <span class="tag">Space Systems</span>
                        <span class="tag">Python</span>
                        <span class="tag">Engineering</span>
                    </div>
                </div>
            </div>
            
            <div class="project-card fade-in stagger-2">
                <div class="project-image" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">🚀</div>
                <div class="project-content">
                    <h3 class="project-title">Mars Lander Project</h3>
                    <p class="project-description">Building a lander for Mars exploration mission. Currently in planning phase, focusing on systems design and mission architecture.</p>
                    <div class="project-tags">
                        <span class="tag">Aerospace</span>
                        <span class="tag">CAD</span>
                        <span class="tag">Mission Planning</span>
                    </div>
                </div>
            </div>
            
            <div class="project-card fade-in stagger-3">
                <div class="project-image" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">🌍</div>
                <div class="project-content">
                    <h3 class="project-title">GIS Workshops</h3>
                    <p class="project-description">Advanced GIS analysis using Google Earth Engine and Copernicus for remote sensing and environmental monitoring.</p>
                    <div class="project-tags">
                        <span class="tag">GIS</span>
                        <span class="tag">Remote Sensing</span>
                        <span class="tag">Python</span>
                    </div>
                </div>
            </div>
            
            <div class="project-card fade-in stagger-4">
                <div class="project-image" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">⚙️</div>
                <div class="project-content">
                    <h3 class="project-title">Project Umbrella</h3>
                    <p class="project-description">Systems integration and testing for Project Umbrella. Worked with Science and Engineering team on comprehensive validation.</p>
                    <div class="project-tags">
                        <span class="tag">Systems Engineering</span>
                        <span class="tag">Testing</span>
                        <span class="tag">Integration</span>
                    </div>
                </div>
            </div>
            
            <div class="project-card fade-in stagger-5">
                <div class="project-image" style="background: linear-gradient(135deg, #30cfd0 0%, #330867 100%);">📐</div>
                <div class="project-content">
                    <h3 class="project-title">Systems Engineering Cameo Workshop</h3>
                    <p class="project-description">Model-Based Systems Engineering using Cameo Systems Modeler. Developed proficiency in SysML and MBSE methodologies.</p>
                    <div class="project-tags">
                        <span class="tag">MBSE</span>
                        <span class="tag">SysML</span>
                        <span class="tag">Modeling</span>
                    </div>
                </div>
            </div>
            
            <div class="project-card fade-in stagger-6">
                <div class="project-image" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);">🔧</div>
                <div class="project-content">
                    <h3 class="project-title">CAD Workshop</h3>
                    <p class="project-description">Advanced CAD training focused on mechanical design. Enhanced skills in SolidWorks, AutoCAD, and 3D modeling.</p>
                    <div class="project-tags">
                        <span class="tag">CAD</span>
                        <span class="tag">SolidWorks</span>
                        <span class="tag">3D Modeling</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Experience -->
    <section id="experience">
        <h2 class="fade-in">Experience</h2>
        <div class="experience-list">
            <div class="experience-item slide-left stagger-1">
                <div class="experience-year">2021 - 2024</div>
                <h3 class="experience-title">Navigating Officer</h3>
                <div class="experience-company">Maritime Operations • Various Vessels</div>
                <p class="experience-description">Operated as Navigating Officer across 3 bulk carriers (Federal Katsura, Bulk Mexico, Federal Tweed) on global trade routes including Trans-Pacific, Atlantic, and Mediterranean routes. Managed integrated bridge systems, cargo operations, and crew supervision.</p>
            </div>
            
            <div class="experience-item slide-left stagger-2">
                <div class="experience-year">2015 - 2020</div>
                <h3 class="experience-title">Trainee Navigating Officer</h3>
                <div class="experience-company">Maritime Operations • Various Vessels</div>
                <p class="experience-description">Trained across 4 diverse vessels including MV SYMI I (container vessel with 1400 reefer plugs), Mountpark (log carrier), Saga Enterprise (general cargo), and MV Federal Spey (bulk carrier). Gained comprehensive experience in navigation, cargo operations, and maritime systems.</p>
            </div>
            
            <div class="experience-item slide-left stagger-3">
                <div class="experience-year">2024 - Present</div>
                <h3 class="experience-title">Space Studies Program</h3>
                <div class="experience-company">International Space University • Strasbourg, France</div>
                <p class="experience-description">Pursuing Master of Space Studies with focus on systems engineering, space operations, and sustainable space systems. Working on CubeSat development and Mars lander projects.</p>
            </div>
        </div>
    </section>
    
    <!-- Contact -->
    <section id="contact">
        <h2 class="fade-in">Get In Touch</h2>
        <div class="contact-content fade-in stagger-1">
            <p>I'm always interested in hearing about new opportunities, collaborations, or just having a conversation about space and maritime systems.</p>
            <a href="mailto:yankit@example.com" class="contact-email">yankit@example.com</a>
            <div class="social-links">
                <a href="https://github.com/" target="_blank">GitHub</a>
                <a href="https://linkedin.com/" target="_blank">LinkedIn</a>
                <a href="https://twitter.com/" target="_blank">Twitter</a>
            </div>
        </div>
    </section>
    
    <!-- Footer -->
    <footer>
        <p>&copy; 2024 Yankit Kukreja. All rights reserved.</p>
    </footer>
    
    <script>
        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
        
        // Intersection Observer for animations
        const observerOptions = {
            threshold: 0.15,
            rootMargin: '0px 0px -80px 0px'
        };
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    
                    // If it's a stat with data-target, animate the number
                    if (entry.target.classList.contains('stat') && entry.target.dataset.target) {
                        animateNumber(entry.target);
                    }
                }
            });
        }, observerOptions);
        
        // Observe all animated elements
        document.querySelectorAll('.fade-in, .slide-left, .slide-right, .scale-in').forEach(el => {
            observer.observe(el);
        });
        
        // Number counter animation
        function animateNumber(element) {
            const target = parseInt(element.dataset.target);
            const numberElement = element.querySelector('.stat-number');
            const duration = 2000; // 2 seconds
            const steps = 60;
            const increment = target / steps;
            let current = 0;
            let step = 0;
            
            const timer = setInterval(() => {
                step++;
                current += increment;
                
                if (step >= steps) {
                    current = target;
                    clearInterval(timer);
                }
                
                // Format the number appropriately
                if (element.dataset.target === '24') {
                    numberElement.textContent = '$' + Math.floor(current) + 'M+';
                } else if (element.dataset.target === '15') {
                    numberElement.textContent = Math.floor(current) + '+';
                } else {
                    numberElement.textContent = Math.floor(current);
                }
            }, duration / steps);
        }
    </script>
</body>
</html>
